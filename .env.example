# Veyrona environment configuration
# Copy to .env and fill in real values. Never commit .env with real secrets.

# --- Server ---
PORT=3000

# --- Database ---
# SQLite file path (local dev/pilot). Point this at a persistent volume in production,
# or swap server/db/db.js for a Postgres client when migrating (Section 7/22).
VEYRONA_DB_PATH=./data/veyrona.db

# --- Auth ---
# Password for the auto-created default admin account (admin@veyrona.local).
# If unset, defaults to "ChangeMe123!" — CHANGE THIS before any real deployment.
VEYRONA_ADMIN_PASSWORD=

# --- AI Gateway (Section 9/21 — provider-neutral) ---
# If ANTHROPIC_API_KEY is unset, Veronica's extraction falls back to a
# conservative rule-based parser (clearly flagged with low confidence) so
# the rest of the app remains testable without a live key.
VEYRONA_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
VEYRONA_AI_MODEL=claude-sonnet-4-6

# --- WhatsApp (Section 12) — not yet wired, placeholders for the integration ---
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Payments (Section 14/26) — provider TBD, placeholders only ---
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
